# tmux Ocular Rooibos — opciones standalone (SIN plugin catppuccin/tmux)
# Recrea la estética actual de ~/.tmux.conf líneas 50-76 (status arriba,
# ventana activa resaltada, borde de panel activo) sin depender del plugin.
# `tmux source-file` este archivo para aplicarlo en caliente.
# status-left/status-right son COMPLETOS y AUTOSUFICIENTES (sesión +
# fecha/hora): tmux.conf no debe definir los suyos, o los pisa al cargar
# después de este archivo.

set -g status-position top
set -g status-style "bg=#191511,fg=#dfd9cc"

set -g window-status-style "fg=#a6a099,bg=#191511"
set -g window-status-current-style "fg=#15110d,bg=#d9b9ff,bold"
set -g window-status-format " #I:#W "
set -g window-status-current-format " #I:#W "
set -g window-status-separator ""

set -g pane-border-style "fg=#38322b"
set -g pane-active-border-style "fg=#bac4ff"

set -g message-style "bg=#2b2520,fg=#dfd9cc"
set -g message-command-style "bg=#2b2520,fg=#dfd9cc"

set -g mode-style "bg=#d9b9ff,fg=#15110d"

set -g status-left-style "fg=#d1cbc0,bg=#191511"
set -g status-right-style "fg=#d1cbc0,bg=#191511"

set -g status-left "#[fg=#15110d,bg=#d9b9ff,bold] #S #[fg=#d1cbc0,bg=#191511,nobold]"
set -g status-right " %d-%m %H:%M "

set -g clock-mode-colour "#a7c8ff"
set -g clock-mode-style 24
