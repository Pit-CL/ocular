# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1e1a15"

# Main text color
theme[main_fg]="#dfd9cc"

# Title color for boxes
theme[title]="#dfd9cc"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#aac8ff"

# Background color of selected item in processes box
theme[selected_bg]="#38322b"

# Foreground color of selected item in processes box
theme[selected_fg]="#aac8ff"

# Color of inactive/disabled text
theme[inactive_fg]="#a6a099"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#e2bfb9"

# Background color of the percentage meters
theme[meter_bg]="#38322b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e2bfb9"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#deb7fc" #Mauve
theme[mem_box]="#a4d399" #Green
theme[net_box]="#f1baa1" #Maroon
theme[proc_box]="#aac8ff" #Blue

# Box divider line and small boxes line color
theme[div_line]="#98938d"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#a4d399"
theme[temp_mid]="#e3c372"
theme[temp_end]="#ffb4ad"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#70d8cb"
theme[cpu_mid]="#89cdff"
theme[cpu_end]="#c7bffb"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#deb7fc"
theme[free_mid]="#c7bffb"
theme[free_end]="#aac8ff"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#89cdff"
theme[cached_mid]="#aac8ff"
theme[cached_end]="#c7bffb"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#feb782"
theme[available_mid]="#f1baa1"
theme[available_end]="#ffb4ad"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#a4d399"
theme[used_mid]="#70d8cb"
theme[used_end]="#7ad2ed"

# Download graph colors (Peach -> Red)
theme[download_start]="#feb782"
theme[download_mid]="#f1baa1"
theme[download_end]="#ffb4ad"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#a4d399"
theme[upload_mid]="#70d8cb"
theme[upload_end]="#7ad2ed"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#89cdff"
theme[process_mid]="#c7bffb"
theme[process_end]="#deb7fc"