# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#f5efe7"

# Main text color
theme[main_fg]="#3f372d"

# Title color for boxes
theme[title]="#3f372d"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#3458a3"

# Background color of selected item in processes box
theme[selected_bg]="#d9d3c9"

# Foreground color of selected item in processes box
theme[selected_fg]="#3458a3"

# Color of inactive/disabled text
theme[inactive_fg]="#918b84"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#77534e"

# Background color of the percentage meters
theme[meter_bg]="#d9d3c9"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#77534e"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#744991" #Mauve
theme[mem_box]="#326726" #Green
theme[net_box]="#854d32" #Maroon
theme[proc_box]="#3458a3" #Blue

# Box divider line and small boxes line color
theme[div_line]="#a19c94"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#326726"
theme[temp_mid]="#725800"
theme[temp_end]="#9a3b38"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#00665e"
theme[cpu_mid]="#006090"
theme[cpu_end]="#5d5391"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#744991"
theme[free_mid]="#5d5391"
theme[free_end]="#3458a3"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#006090"
theme[cached_mid]="#3458a3"
theme[cached_end]="#5d5391"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#8c4900"
theme[available_mid]="#854d32"
theme[available_end]="#9a3b38"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#326726"
theme[used_mid]="#00665e"
theme[used_end]="#006379"

# Download graph colors (Peach -> Red)
theme[download_start]="#8c4900"
theme[download_mid]="#854d32"
theme[download_end]="#9a3b38"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#326726"
theme[upload_mid]="#00665e"
theme[upload_end]="#006379"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#006090"
theme[process_mid]="#5d5391"
theme[process_end]="#744991"