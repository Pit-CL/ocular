# delta — feature 'ocular' (Ocular Manzanilla)
# Generado por ports/build_ports.py — plus/minus derivados por mezcla
# OKLab (base + green/red @ 12%/28%, ver mix_oklab/delta_diff_tints) +
# gate APCA obligatorio (check_delta_pairs, piso cuerpo=60 Lc). Comparte
# el tmTheme de bat (syntax-theme = Ocular Manzanilla). Nombre de feature
# FIJO 'ocular' en ambos modos: ocular-switch reescribe el CONTENIDO de
# este archivo, nunca el include de ~/.gitconfig.

[delta]
    features = ocular

[delta "ocular"]
    syntax-theme = Ocular Manzanilla
    true-color = always
    plus-style = syntax "#dddecf"
    plus-emph-style = syntax "#bdc8af"
    minus-style = syntax "#ecd9d1"
    minus-emph-style = syntax "#dfbcb3"
    zero-style = syntax
    line-numbers-plus-style = "#326726"
    line-numbers-minus-style = "#9a3b38"
    line-numbers-zero-style = "#918b84"
    line-numbers-left-style = "#cdc6bd"
    line-numbers-right-style = "#cdc6bd"
    file-style = "#725800" bold
    file-decoration-style = "#d9d3c9" ul
    hunk-header-style = "#3458a3" bold
    hunk-header-decoration-style = "#e3ddd4" box
    hunk-header-file-style = "#675f57"
    hunk-header-line-number-style = "#725800"
    blame-palette = "#eee8df" "#f5efe7" "#e3ddd4" "#e6e0d7"
    whitespace-error-style = "#9a3b38" reverse
    merge-conflict-ours-style = "#8c4900" bold
    merge-conflict-theirs-style = "#3458a3" bold
