    "notifications.border": "#e6e0d7",
    "notificationLink.foreground": "#5d5391",
    "breadcrumb.foreground": "#817a73",
    "breadcrumb.background": "#f5efe7",
    "breadcrumb.focusForeground": "#3f372d",
    "breadcrumb.activeSelectionForeground": "#5d5391"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#675f57",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#326726"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#006379"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#8c4900"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8c4900",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#744991"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.operator"
      ],
      "settings": {
        "foreground": "#006379"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#3458a3"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#3458a3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Class / Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#725800"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3f372d"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#006379"
      }
    },
    {
      "name": "Language variable (this/self)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#9a3b38",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#006379"
      }
    },
    {
      "name": "JSON / YAML key",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#9a3b38"
      }
    },
    {
      "name": "Constant other (enum)",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#8c4900"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#918b84"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#006379"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#9a3b38"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#9a3b38",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#725800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#3458a3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#326726"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#744991",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#9a3b38"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8c4900"
      }
    },
    {
      "name": "CSS value/unit",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "keyword.other.unit",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#8c4900"
      }
    },
    {
      "name": "JSX component",
      "scope": [
        "support.class.component"
      ],
      "settings": {
        "foreground": "#725800"
      }
    }
  ]
}
