{
  "name": "Ocular Manzanilla",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#3458a3",
    "method": "#3458a3",
    "class": "#725800",
    "type": "#725800",
    "interface": "#725800",
    "enum": "#725800",
    "parameter": "#006379",
    "variable": "#3f372d",
    "variable.readonly": "#8c4900",
    "property": "#006379",
    "enumMember": "#8c4900",
    "decorator": "#3458a3",
    "namespace": "#725800",
    "selfParameter": "#9a3b38",
    "*.declaration": {
      "bold": true
    }
  },
