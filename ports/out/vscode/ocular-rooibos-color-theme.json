    "scrollbarSlider.background": "#a6a09955",
    "scrollbarSlider.hoverBackground": "#a6a09988",
    "scrollbarSlider.activeBackground": "#a6a099aa",
    "progressBar.background": "#c7bffb",
    "terminal.background": "#1e1a15",
    "terminal.foreground": "#dfd9cc",
    "terminal.ansiBlack": "#38322b",
    "terminal.ansiRed": "#ffb4ad",
    "terminal.ansiGreen": "#a4d399",
    "terminal.ansiYellow": "#e3c372",
    "terminal.ansiBlue": "#aac8ff",
    "terminal.ansiMagenta": "#fab1d9",
    "terminal.ansiCyan": "#70d8cb",
    "terminal.ansiWhite": "#d1cbc0",
    "terminal.ansiBrightBlack": "#464038",
    "terminal.ansiBrightRed": "#ffc2bd",
