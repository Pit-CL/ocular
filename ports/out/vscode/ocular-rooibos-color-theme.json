{
  "name": "Ocular Rooibos",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#aac8ff",
    "method": "#aac8ff",
    "class": "#e3c372",
    "type": "#e3c372",
    "interface": "#e3c372",
    "enum": "#e3c372",
    "parameter": "#7ad2ed",
    "variable": "#dfd9cc",
    "variable.readonly": "#feb782",
    "property": "#7ad2ed",
    "enumMember": "#feb782",
    "decorator": "#aac8ff",
    "namespace": "#e3c372",
    "selfParameter": "#ffb4ad",
    "*.declaration": {
      "bold": true
    }
  },
  "colors": {
    "focusBorder": "#c7bffb",
