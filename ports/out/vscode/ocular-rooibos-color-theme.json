    "gitDecoration.deletedResourceForeground": "#ffb4ad",
    "gitDecoration.untrackedResourceForeground": "#a4d399",
    "gitDecoration.ignoredResourceForeground": "#b4afa8",
    "gitDecoration.conflictingResourceForeground": "#feb782",
    "notifications.background": "#191511",
    "notifications.border": "#15110d",
    "notificationLink.foreground": "#c7bffb",
    "breadcrumb.foreground": "#b4afa8",
    "breadcrumb.background": "#1e1a15",
    "breadcrumb.focusForeground": "#dfd9cc",
    "breadcrumb.activeSelectionForeground": "#c7bffb"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#c6c1b7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#a4d399"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7ad2ed"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#feb782"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "support.constant"
      ],
      "settings": {
        "foreground": "#feb782",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#deb7fc"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.operator"
      ],
      "settings": {
        "foreground": "#7ad2ed"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#aac8ff"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#aac8ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Class / Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#e3c372"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#dfd9cc"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#7ad2ed"
      }
    },
    {
      "name": "Language variable (this/self)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#ffb4ad",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#7ad2ed"
      }
    },
    {
      "name": "JSON / YAML key",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ffb4ad"
      }
    },
    {
      "name": "Constant other (enum)",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#feb782"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a6a099"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7ad2ed"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffb4ad"
      }
    },
    {
      "name": "Markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ffb4ad",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e3c372",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#aac8ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#a4d399"
      }
    },
    {
      "name": "Markup link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#deb7fc",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#ffb4ad"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#feb782"
      }
    },
    {
      "name": "CSS value/unit",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "keyword.other.unit",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#feb782"
      }
    },
    {
      "name": "JSX component",
      "scope": [
        "support.class.component"
      ],
      "settings": {
        "foreground": "#e3c372"
      }
    }
  ]
}
