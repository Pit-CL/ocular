#!/usr/bin/env bash
# ocular-switch — instala el theme Ocular (light|dark) en las apps presentes
# de ESTA máquina. Genérico: sin SSH, sin hostnames — detecta cada app con
# `command -v` / existencia de su config y solo actúa si está instalada.
#
# Uso: ocular-switch light|dark
#
# Fuente de los artefactos: ports/out/ (generados por build_ports.py, correr
# ANTES si no existe). Destinos: los paths estándar de ~/.config documentados
# inline en cada sección de abajo.
#
# Clasificación (verificado 2026-07-26 contra docs oficiales/binario donde
# aplica — ver detalle en cada sección):
#   - kitty, ghostty, nvim: conmutan SOLOS por apariencia del SO/`background`
#     de catppuccin/nvim. La instalación es ONE-TIME (mismo resultado sin
#     importar qué `light|dark` se pida) — el argumento del switcher solo
#     decide el `kitty @ set-colors` en caliente (efecto inmediato en
#     sesiones abiertas) y, para oh-my-posh, hacia dónde apunta el symlink.
#   - bat, yazi, lazygit, btop, tmux, gh-dash, statusline, ccmax, herdr,
#     oh-my-posh, delta, claude code: NO conmutan solos — el switcher
#     re-apunta cada uno al modo pedido en cada corrida. herdr, además,
#     dispara `server reload-config` tras reescribir su config (fix
#     2026-07-27: antes el cliente quedaba con el theme viejo hasta un
#     reload manual).
#   - vscode, chrome: fuera de alcance (ver notas en sus secciones).
#
# Límite conocido — TUIs de larga vida (reportado por el usuario con btop,
# 2026-07-26): btop, lazygit y yazi leen su config SOLO al arrancar — no
# tienen reload en caliente. Una instancia ya abierta antes de correr el
# switcher se queda con los colores viejos hasta que se cierra y se abre de
# nuevo; instancias NUEVAS sí toman el modo correcto de inmediato. No es un
# bug de este script, es una limitación de esas apps.
# gh-dash tiene la misma limitación, PERO cuando corre dentro de un pane de
# herdr con servidor local (hoy: nube) el switcher lo recarga solo: mata el
# proceso `gh dash` en foreground con SIGTERM (determinístico, no depende
# del estado de la UI) y lo relanza en el mismo pane — fix 2026-07-27, ver
# bloque más abajo. Fuera de un pane de herdr (o en mac/omen, sin server),
# sigue aplicando la limitación general: cerrar y abrir a mano.
# Gotcha específico de btop: reescribe btop.conf completo AL SALIR. Si una
# instancia vieja de btop sigue abierta cuando corre el switcher y luego se
# cierra, su propio btop.conf (con el color_theme viejo en memoria) pisa el
# que el switcher acaba de escribir. Se autocorrige solo en la SIGUIENTE
# corrida del switcher — no matar procesos de btop del usuario para
# "arreglarlo".
#
# statusline y ccmax no leen directo de ports/out/: consumen
# ~/.config/ocular/mode (el modo activo, "dark"/"light") + su fragmento de
# color propio (~/.config/claude-statusline/colors-<modo>.sh,
# ~/.config/ocular/ccmax-colors.sh). Cablear esos DOS scripts para que
# hagan `source` de sus fragmentos es un cambio en herramientas externas del
# autor — va por PR aparte a ESE repo, no en este switcher.
set -euo pipefail

mode="${1:-}"
case "$mode" in
    dark)  variant="rooibos"    ;;
    light) variant="manzanilla" ;;
    *) echo "Uso: ocular-switch light|dark" >&2; exit 1 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT="${OCULAR_OUT:-$SCRIPT_DIR/out}"
[ -d "$OUT" ] || { echo "No existe $OUT — corre 'python3 ports/build_ports.py' primero." >&2; exit 1; }

ok()   { printf '  \033[32m\xe2\x9c\x93\033[0m %s\n' "$1"; }
skip() { printf '  \xc2\xb7 %s (no instalado, se omite)\n' "$1"; }
note() { printf '  \033[33m!\033[0m %s\n' "$1"; }

echo "Ocular -> $mode ($variant)"

# --- archivo de modo activo: fuente única para consumidores que no leen
#     ports/out/ directo (statusline, ccmax) ---
mkdir -p "$HOME/.config/ocular"
echo "$mode" > "$HOME/.config/ocular/mode"

# --- kitty: dark-theme.auto.conf / light-theme.auto.conf — CONMUTA SOLO por
#     apariencia del SO (feature nativa de kitty, docs.kitty kittens/themes:
#     "creating dark-theme.auto.conf, light-theme.auto.conf y
#     no-preference-theme.auto.conf"). NO se pisan los dos con el mismo modo
#     (eso anulaba el auto-switch, que es justo lo que se restaura acá): dark
#     SIEMPRE = rooibos, light SIEMPRE = manzanilla, sin importar el $variant
#     pedido. no-preference-theme.auto.conf se omite: no existe hoy en el
#     port de referencia de esta máquina (~/.config/kitty solo trae los dos
#     archivos dark/light), así que no se inventa un tercero. ---
if [ -d "$HOME/.config/kitty" ]; then
    cp "$OUT/kitty/ocular-rooibos.conf" "$HOME/.config/kitty/dark-theme.auto.conf"
    cp "$OUT/kitty/ocular-manzanilla.conf" "$HOME/.config/kitty/light-theme.auto.conf"
    if command -v kitty >/dev/null 2>&1; then
        # Efecto inmediato en sesiones abiertas — apunta al modo PEDIDO, no al
        # auto-switch (que de todos modos ya sigue al SO desde los archivos de arriba).
        kitty @ set-colors -a "$OUT/kitty/ocular-$variant.conf" >/dev/null 2>&1 || true
    fi
    ok "kitty (auto-switch nativo: dark=rooibos, light=manzanilla)"
else
    skip "kitty"
fi

# --- ghostty: conmuta SOLO por apariencia del SO vía la sintaxis nativa
#     'light:THEME,dark:THEME' (verificado 2026-07-26 en ghostty.org/docs/
#     config/reference: "light:theme-name,dark:theme-name... el orden no
#     importa"; binario no está instalado en esta máquina — sintaxis tomada
#     de la doc oficial, no de `+show-config`). Instala AMBOS theme files
#     siempre, la línea theme= queda fija (no depende del $variant pedido). ---
if [ -d "$HOME/.config/ghostty" ]; then
    mkdir -p "$HOME/.config/ghostty/themes"
    cp "$OUT/ghostty/ocular-rooibos" "$HOME/.config/ghostty/themes/ocular-rooibos"
    cp "$OUT/ghostty/ocular-manzanilla" "$HOME/.config/ghostty/themes/ocular-manzanilla"
    if [ -f "$HOME/.config/ghostty/config" ] && grep -q '^theme = ' "$HOME/.config/ghostty/config"; then
        sed -i.bak "s/^theme = .*/theme = light:ocular-manzanilla,dark:ocular-rooibos/" "$HOME/.config/ghostty/config"
        rm -f "$HOME/.config/ghostty/config.bak"
    fi
    note "ghostty (auto-switch nativo: theme = light:ocular-manzanilla,dark:ocular-rooibos) — recárgalo con el atajo nativo de reload (no hay API por CLI)"
else
    skip "ghostty"
fi

# --- bat: themes dir + config --theme= + cache rebuild ---
if command -v bat >/dev/null 2>&1; then
    bat_dir="$(bat --config-dir)/themes"
    mkdir -p "$bat_dir"
    cp "$OUT/bat/Ocular Rooibos.tmTheme" "$bat_dir/"
    cp "$OUT/bat/Ocular Manzanilla.tmTheme" "$bat_dir/"
    bat cache --build >/dev/null 2>&1 || true
    name="Ocular Rooibos"; [ "$variant" = manzanilla ] && name="Ocular Manzanilla"
    bat_conf="$(bat --config-dir)/config"
    if [ -f "$bat_conf" ]; then
        sed -i.bak -E "s/--theme=\"[^\"]*\"/--theme=\"$name\"/" "$bat_conf" 2>/dev/null || true
        rm -f "${bat_conf}.bak"
    fi
    ok "bat ($name)"
else
    skip "bat"
fi

# --- yazi: flavors/ + [flavor] dark/light de theme.toml ---
if [ -d "$HOME/.config/yazi" ]; then
    mkdir -p "$HOME/.config/yazi/flavors"
    cp -r "$OUT/yazi/ocular-rooibos.yazi" "$HOME/.config/yazi/flavors/"
    cp -r "$OUT/yazi/ocular-manzanilla.yazi" "$HOME/.config/yazi/flavors/"
    if [ -f "$HOME/.config/yazi/theme.toml" ]; then
        sed -i.bak -E "s/^(dark|light)[[:space:]]*=[[:space:]]*\".*\"/\\1 = \"ocular-$variant\"/" "$HOME/.config/yazi/theme.toml" 2>/dev/null || true
        rm -f "$HOME/.config/yazi/theme.toml.bak"
    fi
    ok "yazi (flavor ocular-$variant)"
else
    skip "yazi"
fi

# --- helper: reemplaza in-place el bloque delimitado por [start, end) tanto
#     en el archivo vivo como en el fragmento propio (ambos comparten el
#     mismo marcador de inicio, así que no hace falta desenvolver el header).
#     Guarda de contenido ajeno: empalmar sin inspeccionar lo que se descarta
#     borraba en silencio cualquier clave ajena que cayera en el tramo — si
#     `foreign_re` matchea algo dentro de [start, end), no se escribe nada y
#     se sale con 3. ---
replace_block() {
    local target="$1" start="$2" end="$3" fragment="$4" foreign_re="${5:-}"
    [ -f "$target" ] || return 1
    python3 - "$target" "$start" "$end" "$fragment" "$foreign_re" <<'PYEOF'
import re
import sys
target, start, end, fragment, foreign_re = sys.argv[1:6]
text = open(target).read()
frag_full = open(fragment).read()
fi = frag_full.find(start)
if fi == -1:
    sys.exit(2)
frag = frag_full[fi:]
i = text.find(start)
if i == -1:
    sys.exit(1)
j = text.find(end, i + len(start))
if j == -1:
    sys.exit(1)
span = text[i + len(start):j]
if foreign_re and re.search(foreign_re, span, re.M):
    sys.exit(3)
text = text[:i] + frag.rstrip("\n") + "\n" + text[j:]
open(target, "w").write(text)
PYEOF
}

# --- lazygit: bloque gui.theme (config.yml completo se preserva) ---
if command -v lazygit >/dev/null 2>&1 && [ -f "$HOME/.config/lazygit/config.yml" ]; then
    rc=0
    replace_block "$HOME/.config/lazygit/config.yml" "  theme:"$'\n' $'\n  authorColors:' \
        "$OUT/lazygit/ocular-$variant.yml" '^ {0,2}[A-Za-z_-]+ *:' || rc=$?
    if [ "$rc" -eq 0 ]; then
        ok "lazygit (bloque gui.theme)"
    elif [ "$rc" -eq 3 ]; then
        note "lazygit: contenido ajeno dentro del tramo del bloque theme — no se tocó (revisar a mano)"
    else
        note "lazygit: no se encontró el bloque theme: esperado — se omite (revisar a mano)"
    fi
else
    skip "lazygit"
fi

# --- gh-dash: bloque theme: (config.yml completo se preserva) ---
if [ -f "$HOME/.config/gh-dash/config.yml" ]; then  # gh-dash es extensión de gh: no hay binario en PATH, la config es el indicador
    rc=0
    replace_block "$HOME/.config/gh-dash/config.yml" $'\ntheme:\n' $'\npager:' \
        "$OUT/gh-dash/ocular-$variant.yml" '^[A-Za-z_-]+ *:' || rc=$?
    if [ "$rc" -eq 0 ]; then
        ok "gh-dash (bloque theme:)"
    elif [ "$rc" -eq 3 ]; then
        note "gh-dash: contenido ajeno dentro del tramo del bloque theme — no se tocó (revisar a mano)"
    else
        note "gh-dash: no se encontró el bloque theme: esperado — se omite (revisar a mano)"
    fi
else
    skip "gh-dash"
fi

# --- gh-dash: reinicio automático de las instancias corriendo dentro de
#     panes de herdr — gh-dash no tiene recarga en caliente (ver nota de
#     TUIs de larga vida arriba); sin esto quedan pintando el theme viejo
#     hasta que alguien las cierre y reabra a mano. Solo aplica donde hay un
#     servidor herdr LOCAL corriendo (hoy: nube); en mac/omen no existe
#     server — note, nunca error. Mecanismo verificado en vivo 2026-07-27:
#     matar el proceso "gh dash" en foreground con SIGTERM (determinístico,
#     no depende del estado de la UI) y relanzarlo en el MISMO pane con
#     'pane send-text' — nunca tocar panes/sesiones/agentes ajenos. ---
HERDR_BIN="$(command -v herdr)" || HERDR_BIN="$HOME/.local/bin/herdr"
if [ -x "$HERDR_BIN" ]; then
    pane_list_json="$("$HERDR_BIN" pane list 2>/dev/null)" && has_herdr_server=1 || has_herdr_server=0
else
    has_herdr_server=0
fi
if [ "$has_herdr_server" -eq 1 ]; then
    pane_ids="$(printf '%s' "$pane_list_json" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for p in data.get("result", {}).get("panes", []):
    print(p["pane_id"])
')"
    restarted=0
    while IFS= read -r pane_id; do
        [ -n "$pane_id" ] || continue
        info="$("$HERDR_BIN" pane process-info --pane "$pane_id" 2>/dev/null)" || continue
        parsed="$(printf '%s' "$info" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("")
    sys.exit(0)
pi = data.get("result", {}).get("process_info", {})
gh_pid = ""
for p in pi.get("foreground_processes", []):
    if p.get("argv") == ["gh", "dash"]:
        gh_pid = p["pid"]
        break
print(gh_pid, pi.get("shell_pid", ""))
')"
        gh_pid="${parsed%% *}"
        shell_pid="${parsed##* }"
        [ -n "$gh_pid" ] || continue
        kill -TERM "$gh_pid" 2>/dev/null || continue
        # esperar a que el pane vuelva al prompt del shell (foreground == shell_pid)
        tries=0
        while [ "$tries" -lt 10 ]; do
            fg="$("$HERDR_BIN" pane process-info --pane "$pane_id" 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    procs = data["result"]["process_info"]["foreground_processes"]
    print(procs[0]["pid"] if procs else "")
except Exception:
    print("")
')"
            [ "$fg" = "$shell_pid" ] && break
            tries=$((tries + 1))
            sleep 0.2
        done
        "$HERDR_BIN" pane send-text "$pane_id" "gh dash"$'\n' >/dev/null 2>&1 || continue
        restarted=$((restarted + 1))
    done <<EOF
$pane_ids
EOF
    if [ "$restarted" -gt 0 ]; then
        ok "gh-dash: $restarted instancia(s) reiniciada(s) con el theme nuevo"
    else
        note "gh-dash: servidor herdr local sin instancias gh-dash corriendo"
    fi
else
    note "gh-dash: sin servidor herdr local — reinicio automático omitido (normal en mac/omen)"
fi

# --- herdr: bloque [theme.custom] (config.toml completo se preserva) ---
if [ -f "$HOME/.config/herdr/config.toml" ]; then  # detección por config, NO command -v: mismo gotcha del LaunchAgent del Mac que oh-my-posh (PATH launchd = /usr/bin:/bin:/usr/sbin:/sbin, binario en ~/.local/bin) — dejaba el config.toml del Mac sin reescribir bajo el watcher automático (bug real 2026-07-27)
    rc=0
    replace_block "$HOME/.config/herdr/config.toml" $'\n[theme.custom]\n' $'\n[keys]' \
        "$OUT/herdr/ocular-$variant.toml" '^\[' || rc=$?
    if [ "$rc" -eq 0 ]; then
        ok "herdr (bloque [theme.custom])"
    elif [ "$rc" -eq 3 ]; then
        note "herdr: contenido ajeno dentro del tramo del bloque theme — no se tocó (revisar a mano)"
    else
        note "herdr: no se encontró el bloque [theme.custom] esperado — se omite (revisar a mano)"
    fi
    # --- herdr: ui.accent — token INDEPENDIENTE de [theme.custom], verificado
    #     2026-07-26 contra `herdr --default-config` (comentario "Accent color
    #     for highlights, borders, and navigation UI") y docs.herdr.dev/
    #     config-reference: es el que pinta los BORDES de panel. NINGUNO de
    #     los 16 tokens de CustomThemeColors los cubre (confirmado con
    #     `strings` sobre el binario: CustomThemeColors no tiene campo
    #     "border"), así que sin este upsert herdr cae a su default propio
    #     (cyan/#89b4fa) — el azul saturado que desentona reportado por el
    #     usuario. Se upsertea con el MISMO hex que theme.custom.accent (se
    #     lee del fragmento ya generado — una sola fuente de verdad, sin
    #     duplicar la paleta en este script) dentro de la sección [ui]
    #     existente (crea la línea si falta, la reemplaza si ya está).
    accent_hex="$(grep -m1 '^accent = ' "$OUT/herdr/ocular-$variant.toml" | sed -E 's/^accent = "([^"]+)".*/\1/')"
    if [ -n "$accent_hex" ]; then
        if python3 - "$HOME/.config/herdr/config.toml" "$accent_hex" <<'PYEOF'
import re
import sys

path, hexval = sys.argv[1], sys.argv[2]
text = open(path).read()
i = text.find("\n[ui]\n")
if i == -1:
    sys.exit(1)
j = text.find("\n[", i + 1)
if j == -1:
    j = len(text)
section = text[i:j]
new_line = f'accent = "{hexval}"'
if re.search(r"(?m)^accent\s*=", section):
    section = re.sub(r"(?m)^accent\s*=.*$", new_line, section, count=1)
else:
    section = section.rstrip("\n") + "\n" + new_line + "\n"
open(path, "w").write(text[:i] + section + text[j:])
PYEOF
        then
            ok "herdr (ui.accent = $accent_hex, bordes de panel)"
        else
            note "herdr: sección [ui] no encontrada — ui.accent no actualizado (revisar a mano)"
        fi
    else
        note "herdr: no se pudo leer accent del fragmento generado — ui.accent no actualizado"
    fi
    # --- herdr: reload-config del servidor tras reescribir el config — sin
    #     esto el cliente attach queda con el theme viejo hasta un reload
    #     manual (bug real 2026-07-27). El server SOLO existe en nube; en
    #     mac/omen esto es un no-op tolerado (note, nunca error). Resuelve el
    #     binario con fallback explícito: mismo gotcha de PATH bajo launchd. ---
    HERDR_BIN="$(command -v herdr)" || HERDR_BIN="$HOME/.local/bin/herdr"
    if [ -x "$HERDR_BIN" ]; then
        if "$HERDR_BIN" server reload-config >/dev/null 2>&1; then
            ok "herdr server reload-config"
        else
            note "herdr: sin servidor local corriendo — reload-config omitido (normal en mac/omen)"
        fi
    else
        note "herdr: binario no encontrado (ni en PATH ni en ~/.local/bin/herdr) — reload-config omitido"
    fi
else
    skip "herdr"
fi

# --- btop: themes dir + color_theme de btop.conf ---
if command -v btop >/dev/null 2>&1; then
    mkdir -p "$HOME/.config/btop/themes"
    cp "$OUT/btop/ocular-$variant.theme" "$HOME/.config/btop/themes/"
    if [ -f "$HOME/.config/btop/btop.conf" ]; then
        sed -i.bak -E "s/^color_theme = \".*\"/color_theme = \"ocular-$variant\"/" "$HOME/.config/btop/btop.conf" 2>/dev/null || true
        rm -f "$HOME/.config/btop/btop.conf.bak"
    fi
    ok "btop (ocular-$variant)"
else
    skip "btop"
fi

# --- oh-my-posh: instala AMBOS + symlink estable ocular-active.omp.json que
#     el switcher mueve al modo pedido en cada corrida. El zshrc (si aún
#     apunta al catppuccin_mocha.omp.json original) se reapunta UNA VEZ al
#     symlink, no al archivo del modo — así queda estable para siempre y
#     coincide con dotfiles (cero drift; correr el switcher de nuevo solo
#     mueve el symlink, no vuelve a tocar el zshrc). ---
if [ -d "$HOME/.config/ohmyposh" ]; then  # detección por config, NO command -v: en el Mac brew solo está en PATH de login shell (el watcher de launchd nunca lo vería); esta sección solo copia archivos y mueve un symlink
    cp "$OUT/ohmyposh/ocular-rooibos.omp.json" "$HOME/.config/ohmyposh/"
    cp "$OUT/ohmyposh/ocular-manzanilla.omp.json" "$HOME/.config/ohmyposh/"
    ln -sf "ocular-$variant.omp.json" "$HOME/.config/ohmyposh/ocular-active.omp.json"
    # El zshrc NO se toca desde acá: la config canónica viene de dotfiles y ya
    # apunta al symlink con fallback a catppuccin_mocha. (El antiguo sed
    # "one-time" pisaba justamente esa línea de fallback y la dejaba circular
    # — bug detectado 2026-07-26.)
    ok "oh-my-posh (symlink ocular-active.omp.json -> ocular-$variant.omp.json)"
else
    skip "oh-my-posh"
fi

# --- statusline (Claude Code): fragmento de color, el 'source' queda
#     pendiente de cablear en el script consumidor externo (otro repo) ---
mkdir -p "$HOME/.config/claude-statusline"
sl_theme="dark"; [ "$variant" = manzanilla ] && sl_theme="light"
cp "$OUT/statusline/ocular-$variant.sh" "$HOME/.config/claude-statusline/colors-$sl_theme.sh"
note "statusline: fragmento instalado en ~/.config/claude-statusline/colors-$sl_theme.sh — falta cablear el 'source' en statusline-command.sh (herramienta externa del autor, fuera de este switcher)"

# --- claude code: theme custom (~/.claude/themes/ocular.json). Detección por
#     directorio de config, NUNCA `command -v claude` (mismo gotcha de PATH
#     bajo launchd que herdr). Claude Code vigila esa carpeta: reescribir el
#     archivo (SIEMPRE cp, jamás symlink — el file-watch necesita escritura
#     real) repinta las sesiones abiertas sin reinicio (verificado 2026-07-27
#     contra code.claude.com/docs/en/terminal-config). Requiere
#     "theme": "custom:ocular" en ~/.claude/settings.json (fuera de este
#     switcher, se setea una sola vez). ---
if [ -d "$HOME/.claude" ]; then
    mkdir -p "$HOME/.claude/themes"
    cp "$OUT/claude/ocular-$variant.json" "$HOME/.claude/themes/ocular.json"
    ok "claude code (theme ocular; sesiones abiertas repintan solas)"
else
    skip "claude code"
fi

# --- ccmax: sin condición de comando (el archivo no estorba si ccmax no
#     está instalado) — el 'source' queda pendiente de cablear en el script
#     consumidor externo (otro repo), igual que statusline ---
mkdir -p "$HOME/.config/ocular"
cp "$OUT/ccmax/ocular-$variant.sh" "$HOME/.config/ocular/ccmax-colors.sh"
ok "ccmax (fragmento instalado en ~/.config/ocular/ccmax-colors.sh)"

# --- tmux: archivo standalone + source-file en caliente si hay servidor ---
if [ -d "$HOME/.config/tmux" ] || [ -f "$HOME/.tmux.conf" ]; then
    mkdir -p "$HOME/.config/tmux"
    cp "$OUT/tmux/ocular-$variant.tmuxtheme" "$HOME/.config/tmux/ocular-theme.tmuxtheme"
    if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
        tmux source-file "$HOME/.config/tmux/ocular-theme.tmuxtheme" 2>/dev/null || true
        ok "tmux (aplicado en caliente a la sesión activa)"
    else
        ok "tmux (instalado en ~/.config/tmux/ocular-theme.tmuxtheme)"
    fi
    note "tmux: para que persista entre reinicios hay que cambiar .tmux.conf (reemplazar el bloque del plugin catppuccin/tmux por 'source-file ~/.config/tmux/ocular-theme.tmuxtheme') — cambio estructural fuera de este switcher"
else
    skip "tmux"
fi

# --- nvim: spec lazy.nvim, auto light/dark (no depende del modo elegido acá) ---
if [ -d "$HOME/.config/nvim/lua/plugins" ]; then
    cp "$OUT/nvim/ocular.lua" "$HOME/.config/nvim/lua/plugins/ocular.lua"
    ok "nvim (lazy.nvim spec instalado, flavour=auto — no depende de light|dark)"
else
    skip "nvim"
fi

# --- vscode: necesita empaquetarse como extensión, no es un archivo suelto ---
vscode_settings=""
[ -f "$HOME/Library/Application Support/Code/User/settings.json" ] && vscode_settings="$HOME/Library/Application Support/Code/User/settings.json"
[ -f "$HOME/.config/Code/User/settings.json" ] && vscode_settings="$HOME/.config/Code/User/settings.json"
if [ -n "$vscode_settings" ]; then
    note "VSCode detectado — un color-theme.json suelto no alcanza, VSCode exige una extensión (package.json + contributes.themes). Instalación manual, fuera de este switcher."
else
    skip "vscode"
fi

# --- delta: feature file propio ([delta "ocular"], fondos de diff por rol,
#     ver ports/out/delta/README.md) + syntax-theme de bat por nombre.
#     Detección por directorio de config, NO command -v: mismo gotcha de
#     PATH bajo launchd del Mac que herdr/oh-my-posh (brew fuera del PATH no-
#     login). El nombre de feature es FIJO "ocular" en ambas variantes: el
#     ~/.gitconfig del usuario y su [include] no cambian nunca, solo el
#     CONTENIDO de ocular.gitconfig — delta no cachea, el próximo diff ya lo
#     toma. git config --global delta.syntax-theme queda igual que antes
#     (mismo valor que ya fija el feature; no hay contradicción, el feature
#     de todos modos pisa el [delta] principal). ---
if [ -d "$HOME/.config/delta" ]; then
    cp "$OUT/delta/ocular-$variant.gitconfig" "$HOME/.config/delta/ocular.gitconfig"
    name="Ocular Rooibos"; [ "$variant" = manzanilla ] && name="Ocular Manzanilla"
    git config --global delta.syntax-theme "$name"
    ok "delta (feature ocular + delta.syntax-theme = $name)"
else
    skip "delta"
fi

echo
echo "Chrome (modo desarrollador) es manual — ver ports/out/chrome/README.md (no hay API de recarga por script)."
echo "Listo: Ocular $mode aplicado en las apps detectadas."
